<script>
     
    function showsuccess()
    {
        alert('successfully downloaded');
    }

    function JSalert(msgType, msg) {
        if (msgType == "SUCCESS") {
            Swal.fire(msg, "Batch Requisition", "success", 2000, true).then(okay => {
                if (okay) {
                    location.reload(true);
                }
            });
        } else {
            Swal.fire(msg, "Batch Requisition", "error", 2000, true);
        }
    }
    
    $('#btnSelectAttachment').click(function () {
        $('#btnSelectFile').click();
    });

    $('#btnUpload').click(function () {
        $('#btnOpenFile').click();
    });

    function DownloadTemplate(){
        $.ajax({
            type: "Get",
            url: "/BatchRequisition/DownloadFileFromWeb",
            //processData: false,
            //contentType: false,
            //data: fileData,
            //dataType: 'html',
            success: function (result) {
                JSalert(response.success, response.errormsg);
            },
            error: function (xhr, status, error) {

            }
        });
    }

    function ReadTemplate(input) {
        if (window.FormData !== undefined) {

            var fileData = new FormData();
            var files = $("#btnOpenFile")[0].files;
            for (var i = 0; i < files.length; i++) {
                fileData.append("files", files[i]);
            }

            $.ajax({
                type: "POST",
                url: "/BatchRequisition/ReadBatchTemplate",
                processData: false,
                contentType: false,
                data: fileData,
                dataType: 'html',
                success: function (result) {
                    $("#tbodyBatchSummary").html(result);
                    //$("#tbodyBatchItems").html(result);
                },
                error: function (xhr, status, error) {

                }
            });

        } else {
            alert("Data is not supported.");
        }
    }

    

</script>