@using Newtonsoft.Json;

@model SPASv2.Models.BatchRequisitionViewModel
@{
    Layout = null;
}

<table class="table table-borderless datatable table-striped " style="min-height:200px;" id="Tbl">
    <thead>
        <tr>
            <th>
                P.O. No
            </th>
            <th>
                Sales Invoice
            </th>
            <th>
                Vendor Name
            </th>
            <th>
                Amount
            </th>
            <th>
                HP Deduction
            </th>
            <th>
                Freight Amount
            </th>
            <th>Attachments</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model.BatchPaymentHdrList)
        {
            <tr>
                <td>
                    @item.PONo
                </td>
                <td>
                    @item.SalesInvoiceNo
                </td>
                <td>
                    @item.PayeeName
                </td>
                <td class="money">
                    <div class="currencySymbol">
                        &#8369 @string.Format("{0:#,0.00}",  item.Amount)
                    </div>
                </td>
                <td class="money">
                    <div class="currencySymbol">
                        &#8369 @string.Format("{0:#,0.00}",  item.HPDeduction)
                    </div>
                </td>
                <td class="money">
                    <div class="currencySymbol">
                        &#8369 @string.Format("{0:#,0.00}",  item.FreightAmount)
                    </div>
                </td>
                <td>
                    @foreach (var attItem in Model.RequestAttachments.Where(t => t.RequestNo == (item.PONo + item.SalesInvoiceNo)).ToList())
                    {
                        string[] _validExtensions = { ".jpeg", ".jpg", ".bmp", ".gif", ".png", ".tiff", ".tif", ".raw" };
                        bool isImage = _validExtensions.Contains(System.IO.Path.GetExtension(attItem.FileName));

                        <a href="@attItem.Src" target="_blank" @*onclick="DisplayAttachment('@attItem.Src', '@attItem.FileName', @isImage.ToString().ToLower())"*@>
                            <i class="bi bi-paperclip" style="color:darkblue;"></i>
                            @attItem.FileName
                        </a>
                        <br />
                        @*<a><i class="bi bi-paperclip" style="color:darkblue;"></i>@attItem.FileName</a> <br />*@
                    }
                </td>
            </tr>
        }


    </tbody>
</table>


<div class="card-title mb-2">
    <a class="card-title">Batch Request Details</a>
</div>

<table class="table table-borderless datatable table-striped " style="min-height:200px;" id="Tbl">
    <thead>
        <tr>
            <th>
                P.O. No
            </th>
            <th>
                Department
            </th>
            <th>
                Item Description
            </th>
            <th>
                Balance
            </th>
            <th>
                Quantity
            </th>
            <th>
                Amount
            </th>
            <th>
                Reference Receipt
            </th>
            <th>
                DR.No
            </th>
            <th>
                DR.Date
            </th>
            <th>
                S.I. No
            </th>
            <th>
                SI.Date
            </th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model.BatchPaymentDtlList)
        {
            <tr>
                <td>
                    @item.PONo
                </td>
                <td>
                    @item.Department
                </td>
                <td>
                    @item.ItemDescription
                </td>
                <td class="money">
                    @item.Balance
                </td>
                <td class="money">
                    @item.Quantity
                </td>
                <td class="money">
                    <div class="currencySymbol">
                        &#8369 @string.Format("{0:#,0.00}",  item.Amount)
                    </div>
                </td>
                <td>
                    @item.ReferenceReceipt
                </td>
                <td>
                    @item.DeliveryNo
                </td>
                <td>
                    @item.DeliveryDate.ToShortDateString()
                </td>
                <td>
                    @item.SalesInvoice
                </td>
                <td>
                    @item.SalesInvoiceDate.ToShortDateString()
                </td>


            </tr>
        }
    </tbody>
</table>

