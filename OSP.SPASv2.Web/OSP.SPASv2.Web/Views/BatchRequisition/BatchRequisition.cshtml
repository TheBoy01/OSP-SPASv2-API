<script>

    $('#btnSelectAttachment').click(function () {
        $('#btnSelectFile').click();
    });

    $('#btnUpload').click(function () {
        $('#btnOpenFile').click();
    });

    var filedir = document.getElementById("btnOpenFolder").innerHTML;

    if (filedir != '') {
        //navigator.clipboard.writeText(filedir);
        ShowAlert({
            title: 'Batch Folder Created',
            text: "Please organize files into the folder for attachments. <br/><br/>Folder path: <b style= 'color:#6c63ff;'>" + filedir + "</b>",
            icon: 'success',
            showCancelButton: false,
            successmethod: "RedirecttoFiles()"
        });
    }


    function ReadTemplate(input) {
        if (window.FormData !== undefined) {

            var fileData = new FormData();
            var files = $("#btnOpenFile")[0].files;
            for (var i = 0; i < files.length; i++) {
                fileData.append("files", files[i]);
            }

            //$('#btnOpenFile').value ="";

            $.ajax({
                type: "POST",
                url: "/BatchRequisition/ReadBatchTemplate",
                processData: false,
                contentType: false,
                data: fileData,
                //dataType: 'html',
                beforeSend: function () {
                    ShowLoader();
                },
                success: function (result) {
                    //alert(result);
                    if ( result.success == false)
                    {
                        ShowAlert(
                            {
                                title: 'Batch Upload',
                                text: result.error,
                                icon: 'error',
                                //successmethod: "GotoBatchDetails()"
                            });

                    }
                    else { $("#tbodyBatchSummary").html(result); }
                    
                    $("#btnOpenFile").value = '';
                    //alert("oh nono");
                    //$("#tbodyBatchItems").html(result);
                },
                error: function (xhr, status, error) {
                    $("#btnOpenFile").value = '';
                    ShowAlert(
                        {
                            title: 'Error',
                            text: error,
                            icon: 'error'
                        });
                },
                complete: function (data) {
                    $("#loader").modal("hide");
                }
            });

        } else {
            alert("Data is not supported.");
        }
    }

    function OpenDirectory() {
        $.ajax({
            url: '/Requisition/OpenFolderPath',
            type: 'GET',
            dataType: 'json',
            data: { path: filedir },
            beforeSend: function () {
                $("#loader").modal("show");
            },
            success: function (response) {
            },
            error: function () {
            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });

    }

