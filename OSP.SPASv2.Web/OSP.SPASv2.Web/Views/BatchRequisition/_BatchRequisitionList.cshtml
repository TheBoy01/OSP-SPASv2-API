@using Newtonsoft.Json;
@model SPASv2.Models.BatchRequisitionViewModel
@{
    Layout = null;
}

<table class="table table-borderless datatable table-striped " style="min-height:200px;" id="Tbl">
    <thead>
        <tr>
            <th>
                Company
            </th>
            <th>
                VendorName
            </th>
            <th>
                Payee Name
            </th>
            <th>
                Amount
            </th>
            <th>Remarks</th>
            <th>Attachments</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.qryRequisitionHdrList.Count; i++)
        {
            <tr>
                <td>
                    @Model.qryRequisitionHdrList[i].CompanyName
                </td>
                <td>
                    @Model.qryRequisitionHdrList[i].VendorName
                </td>
                <td>
                    @Model.qryRequisitionHdrList[i].PayeeName
                </td>
                <td>
                    &#8369 @string.Format("{0:#,0.00}",  @Model.qryRequisitionHdrList[i].Amount) 
                </td>
                <td>
                    @Model.qryRequisitionHdrList[i].Remarks
                </td>
                <td>
                    @foreach (var attItem in Model.RequestAttachments.Where(t => t.RequestNo == (@Model.qryRequisitionHdrList[i].CompanyName.Replace(".","") + " - " + @Model.qryRequisitionHdrList[i].VendorName)).ToList())
                    {
                      @*  string[] _validExtensions = { ".jpeg", ".jpg", ".bmp", ".gif", ".png", ".tiff", ".tif", ".raw" };
                        bool isImage = _validExtensions.Contains(System.IO.Path.GetExtension(attItem.FileName));*@
                        <a href="@attItem.Src" target="_blank" @*onclick="ShowImage('@attItem.Src', '@attItem.FileName', @isImage.ToString().ToLower())"*@>
                            <i class="bi bi-paperclip" style="color:darkblue;"></i>
                            @attItem.FileName
                        </a>

                        @*<a><i class="bi bi-paperclip" style="color:darkblue;"></i>@attItem.FileName</a> *@<br />
                    }
                </td>
            </tr>
        }

    </tbody>
</table>


<div class="card-title mb-2">
    <a class="card-title">Batch Request Details</a>
</div>

<table class="table table-borderless datatable table-striped " style="min-height:200px;" id="Tbl">
    <thead>
        <tr>
            <th>
                Company Type
            </th>
            <th>
                Department
            </th>
            <th>
                Vendor Name
            </th>
            <th>
                Item Description
            </th>
            <th>
                Quantity
            </th>
            <th>
                Item Amount
            </th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.qryRequisition.ToList().Count; i++)
        {
            <tr>
                <td>
                    @Model.qryRequisition[i].CompanyType
                </td>
                <td>
                    @Model.qryRequisition[i].DeptDesc
                </td>
                <td>
                    @Model.qryRequisition[i].PayeeName
                </td>
                <td>
                    @Model.qryRequisition[i].ItemDesc
                </td>
                <td>
                    @Model.qryRequisition[i].Quantity
                </td>
                <td>
                    &#8369 @string.Format("{0:#,0.00}",  @Model.qryRequisition[i].Gross) @*@Math.Round(Model.qryRequisition[i].Gross,2, MidpointRounding.AwayFromZero)*@ @**@
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.isUploadTemplate)
