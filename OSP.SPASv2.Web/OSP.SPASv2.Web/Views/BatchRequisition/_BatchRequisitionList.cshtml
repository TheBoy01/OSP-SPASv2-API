    }

    var BatchPRNo;

    function UploadBatch() {
        ShowAlert({
            title: 'Batch Upload',
            text: "Are you sure to upload batch list?",
            icon: 'question',
            showCancelButton: true,
            successmethod: "InsertBatch()"
        })
    }

    function InsertBatch() {
        var fileData = new FormData();
        //console.log(RequestFiles);
        if (RequestFiles != null) {
            for (var i = 0; i < RequestFiles.length; i++) {
                fileData.append("files", RequestFiles[i]);
            }
        }

        fileData.append("vm", JSON.stringify(@Html.Raw(JsonConvert.SerializeObject(Model))));
        // console.log(fileData);
        $.ajax({

            type: "POST",
            url: "/BatchRequisition/UploadBatch",
            processData: false,
            contentType: false,
            data: fileData,
            dataType: 'json',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                
                //alert(result.error);
                //
                if (result.success == false)
                {
                    ShowAlert(
                        {
                            title: 'Batch Upload',
                            text: result.error,
                            icon: 'error',
                            //successmethod: "GotoBatchDetails()"
                        });
                }
                else
                {
                    BatchPRNo = result.BatchPRNo;

                    ShowAlert(
                    {
                        title: 'Batch Upload',
                        text: "Batch successfully uploaded",
                        icon: 'success',
                        successmethod: "GotoBatchDetails()"
                    });
                }

            },
            error: function (xhr, status, error) {
                ShowAlert(
                    {
                        title: 'Error',
                        text: error,
                        icon: 'error'
                    });
            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }


    function GotoBatchDetails() {
        window.location.href = '/BatchRequisition/Details/' + BatchPRNo;
    }
</script>
 