<script>
    new DataTable('#dtActiveBatchPR', {
        responsive: true
    });

    var RequestFiles;
    function UploadAttachments(e) {
        var ReqNoList = [];

        var checkedBoxes = document.querySelectorAll('input[id="SelectedRecord"]:checked');
        checkedBoxes.forEach(chk => {
            chk.closest("tr").querySelectorAll('td:not(:first-child)').forEach((td, index) => {
                if (index == 1) {
                    ReqNoList.push(td.innerHTML);
                }
            });
        })

        //var prnolist = JSON.stringify(ReqNoList);
        //console.log(prnolist);

        var fileData = new FormData();
        RequestFiles = e.target.files;

        for (var i = 0; i < RequestFiles.length; i++) {

            fileData.append("files", RequestFiles[i]);
        }


        fileData.append("prnolist", JSON.stringify(ReqNoList));
        //fileData.append("vm", JSON.stringify(@Html.Raw(JsonConvert.SerializeObject(Model))));

        if (ReqNoList.length > 0) {
            $.ajax({
                type: "POST",
                url: "/BatchRequisition/UploadFileList",
                processData: false,
                contentType: false,
                dataType: 'html',
                data: fileData,
                beforeSend: function () {
                    ShowLoader();
                },
                success: function (result) {
                    alert("Attachment Uploaded!");
                },
                error: function (xhr, status, error) {
                    //ShowAlert(
                    //    {
                    //        title: 'Error',
                    //        text: error,
                    //        icon: 'error'
                    //    });
                    alert(error);
                },
                complete: function (data) {
                    $("#loader").modal("hide");
                }
            });
        } 
    }

    function DownloadFolderTemplate() {

        var ReqNoList = [];

        var checkedBoxes = document.querySelectorAll('input[id="SelectedRecord"]:checked');
        checkedBoxes.forEach(chk => {
            chk.closest("tr").querySelectorAll('td:not(:first-child)').forEach((td, index) => {
                if (index == 1) {
                    ReqNoList.push(td.innerHTML);
                }
            });
        })

        var ReqList = JSON.stringify(ReqNoList);
         
        if (ReqNoList.length > 0) {

            $.ajax({
                type: "POST",
                url: "/BatchRequisition/CreateFolderTemplate",
                data: { ReqNoList: ReqList },
                beforeSend: function () {
                    ShowLoader();
                },
                success: function (result) {
