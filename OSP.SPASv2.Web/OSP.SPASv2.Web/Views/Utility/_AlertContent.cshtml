
@model SPASv2.Models.UtilityViewModel

@{
    Layout = null;
}

@{
    string stricon = string.Empty;
    string stralert = string.Empty;
    string strbtn = string.Empty;

}
@switch (Model.Alert.icon)
{
    
    case "question":
        {
            stricon = "bi bi-question-diamond";
            stralert = "alert-primary";
            strbtn = "btn-question";
            break;
        }
    case "success":
        {
            stricon = "bi bi-check2-circle";
            @*stralert = "alert-success";*@
            strbtn = "btn-success";
            break;
        }
    case "info":
        {
            
            stricon = "bi bi-info-circle";
            stralert = "alert-info";
            strbtn = "btn-info";
            break;
        }
    case "warning":
        {
            stricon = "bi bi-exclamation-triangle";
            stralert = "alert-warning";
            strbtn = "btn-warning";
            break;
        }
    case "error":
        {
            stricon = "bi bi-shield-exclamation";
            stralert = "alert-danger";
            strbtn = "btn-danger";
            break;
        }
    default:
        {
            break;
        }
}

<style>
    .btn-danger {
        font-weight: bold;
        background-color: #e57782;
    }

    .btn-question {
        color: #fff !important;
        background-color: #63a3ff !important;
        border-color: #0b5ed7 !important;
    }

        .btn-question:hover {
            color: #fff !important;
            background-color: #0b5ed7 !important;
            border-color: #0a58ca !important;
        }

   
</style>


<div class="alert @stralert alert-dismissible fade show" role="alert" style="margin-bottom:0px !important; border-radius:10px;">

    <h2>

        @*@if (Model.Alert.icon == "success")
        {
            <img src="~/template/img/check.gif" width="60px" height="40px" />
        }
        else if (Model.Alert.icon == "question")
        {
            <img src="~/template/img/question.gif" width="60px" height="40px" />
            
        }
        else
        {
            <i class="@stricon"></i>
        }*@

        

        
        @if (Model.Alert.title.Trim() != string.Empty)
        {
            @Model.Alert.title
        }
        else
        {
            @Model.Alert.text
        }
        
    </h2>

    @if (Model.Alert.title.Trim() != string.Empty)
    {
        <p>@Model.Alert.text</p>
    }
    <hr>
    <center>
        <button type="button" class="btn @strbtn" onclick="ReturnOk('@Model.Alert.successmethod')" style="font-weight:bold;">@Model.Alert.confirmButtonText</button>
        
        @if(Model.Alert.showCancelButton)
        {
            
            <button type="button" class="btn btn-danger" data-bs-dismiss="modal" >Cancel</button>
        }
    </center>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>


