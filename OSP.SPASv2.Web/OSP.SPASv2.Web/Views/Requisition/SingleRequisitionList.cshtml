<script>
    var Filters = [];

    $(function()
    {
        $("#btnSubmit").click(function () {
            $("input[name='htmlTable']").val($("#divRequisitionList").html())
        })
        
    })

    function RefreshRequisitionList()
    {
        $.ajax({
            type: "POST",
            url: "/Requisition/GetRequisitionList",
            data: { Filters: JSON.stringify(Filters)},
            beforeSend: function () {
                ShowLoader();
            },
            success: function (response) {
                $("#divRequisitionList").html(response);
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }
</script>

