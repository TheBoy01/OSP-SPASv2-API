    function ConfirmPayment() {
        var RequisitionViewModel = @Html.Raw(JsonConvert.SerializeObject(Model));

        var fileData = new FormData();
        for (var i = 0; i < RequestFiles.length; i++) {
            fileData.append("files", RequestFiles[i]);
        }
        var model = @Html.Raw(JsonConvert.SerializeObject(Model));
        fileData.append("vm", JSON.stringify(@Html.Raw(JsonConvert.SerializeObject(Model))));

        $.ajax({
            type: "POST",
            url: "/Requisition/ConfirmPaymentRequest",
            processData: false,
            contentType: false,
            data: fileData,
            dataType: 'json',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                ShowAlert(
                    {
                        title: 'Payment Confirmation',
                        text: "Requisitions successfully confirmed!",
                        icon: 'success',
                        successmethod: "ReloadConfirmation()"
                    });

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }
</script>