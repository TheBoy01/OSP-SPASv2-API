@model SPASv2.Models.RequisitionViewModel


@{
    ViewData["Title"] = ViewData["pagetitle"];
}   

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"
        integrity="sha256-xLD7nhI62fcsEZK2/v8LsBcb4lG7dgULkuXoXB/j91c="
        crossorigin="anonymous"></script>*@

<style>
    #basic-addon1 {
        width: 150px;
        background-color: #dedcff;
    }

    .input-group {
        margin-bottom: 5px;
    }
</style>



@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}


<main id="main" class="main">
    
    <div class="pagetitle">
        <h1>Requisition Details</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item">Requisition</li>
                <li class="breadcrumb-item" active>@Model.PRNo</li>
            </ol>
        </nav>
    </div>
    @{
        if (Model.RequisitionInfo.MainReqNo == Model.RequisitionInfo.ReqNo)
        {
            Model.isCreatePaymentBtn = true;
        }
    }
    @await Html.PartialAsync("RequisitionDetails", Model)

</main>

