    function Void() {
        $("#modalVoidRequest").modal("show");
        //ShowAlert({
        //    title: 'Requisition',
        //    text: "Are you sure you want to void <b class='text-primary' >" + @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionInfo.ReqNo)) + "</b> ?",
        //    icon: 'question',
        //    showCancelButton: true,
        //    successmethod: "ConfirmVoidRequest()",
        //    confirmButtonText: "Yes"
        //})
    }

    function ConfirmVoidRequest() {
        var ReqNo = @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionInfo.ReqNo));
        var rescode = $('#cboVoidReason').val();
        var remarks = $('#txtVoidRemarksId').val();

        if (ValidateReason(rescode, remarks, "void") == false) { return; }

        $("#modalVoidRequest").modal("hide");
        //alert($('#cboVoidReason').val() + ' ' + $('#txtVoidRemarksId').val());
        $.ajax({
            type: "POST",
            url: "/Requisition/VoidRequest",
            data: { ReqNo: ReqNo, ReasonCode: rescode, Remarks: remarks },
            dataType: 'json',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                if (result.isVoid) {
                    ShowAlert({
                        title: 'Requisition',
                        text: "Request no. " + ReqNo + " successfully tagged as void!",
                        icon: 'success',
                        successmethod: "SuccessfulVoid()",
                    });
                }
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });

    }

    function SuccessfulUpdate()
    {
        location.reload();
    }

    function SuccessfulVoid() {
        window.location.href = "/";
    }

    function Verify() {

        var mode = @Html.Raw(JsonConvert.SerializeObject(Model.forapproval));
        if (mode == "VERIFIER") {
            process = "verified";

            ShowAlert({
                title: 'Requisition',
                text: "Are you sure you want to tag requisition as verified?",
                icon: 'question',
                showCancelButton: true,
                successmethod: "VerifyAsRegular()",
                cancelmethod: "VerifyAsRush()",
                cancelButtonText: "Tag As RUSH",
                confirmButtonText: "Tag As REGULAR"
            })
        }
        else {
            process = "approved";
            ShowAlert({
                title: 'Requisition',
                text: "Are you sure you want to tag requisition as approved?",
                icon: 'question',
                showCancelButton: true,
                successmethod: "VerifyAsRegular()",
                confirmButtonText: "Yes"
            })
        }
    }

    function VerifyAsRegular() {
        SetAsVerified(false);
    }


    function SetAsVerified(isRush) {
        var ReqNo = @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionInfo.ReqNo));

        $.ajax({
            type: "POST",
            url: "/Requisition/VerifyRequest",
            data: { ReqNo: ReqNo, isRush: isRush, RushReason: RushReason, RushRemarks: RushRemarks },
            dataType: 'json',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                if (result.isVerified) {
                    ShowAlert({
                        title: 'Requisition',
                        text: "Record successfully tagged as " + process + "!",
                        icon: 'success',
                        successmethod: "SuccessfulVerification()",
                    });
                }
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");


            }
        });
    }

    function SuccessfulVerification() {
        location.reload();
    }

