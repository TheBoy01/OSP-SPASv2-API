    function CanUpdateReqDetails() {
        var fileData = new FormData();

        var qryUpdateReqDetails = {
            UserCode: "",
            ReqNo: @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionInfo.ReqNo)),
            SINo: $('#txtSalesInvoiceNo').val(),
            SIDate: $('#dtpSIDate').val(),
            Deduction: $('#txtDeduction').val(),
            TotalAmount: $('#txtTotalAmount').val(),
            Freight: $('#txtFreight').val()
        };

        if (RequestFiles != null) {
            for (var i = 0; i < RequestFiles.length; i++) {
                fileData.append("files", RequestFiles[i]);
            }
        }

        fileData.append("model", JSON.stringify(qryUpdateReqDetails));

        $.ajax({
            type: "POST",
