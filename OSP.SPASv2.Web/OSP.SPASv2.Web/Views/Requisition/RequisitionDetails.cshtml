    function VerifyAsRush() {
        $("#modalVerifyRush").modal("show");
    }

    var RushReason;
    var RushRemarks;

    function ConfirmVerifyRush() {

        RushReason = $('#cboRushReason').val();
        RushRemarks = $('#txtRushRemarksId').val();

        if (ValidateReason(RushReason, RushRemarks, "verify (RUSH)") == false) { return; }
        $("#modalVerifyRush").modal("hide");

        SetAsVerified(true);
    }


    function ConfirmDenialRequest() {

        //alert('Record successfully denied! ' + $('#cboDenialReason').val() + ' ' + $('#txtDenialRemarksId').val());
        //location.reload();
        var ReqNoList = [];

        var ReqNo = @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionInfo.ReqNo));
        var rescode = $('#cboDenialReason').val();
        var remarks = $('#txtDenialRemarksId').val();


        if (ValidateReason(rescode, remarks, "deny") == false) { return; }

        $("#modalDenyRequest").modal("hide");

        ReqNoList.push(ReqNo);
        $.ajax({
            type: "POST",
            url: "/Requisition/DisapprovePRAuthorizationALL",
            data: { prno: JSON.stringify(ReqNoList), reason: rescode, Remarks: remarks },
            dataType: 'json',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                if (result.success) {
                    ShowAlert({
                        title: 'Requisition',
                        text: "Request no. " + ReqNo + " successfully tagged as denied!",
                        icon: 'success',
                        successmethod: "SuccessfulVoid()",
                    });
                }
                else {
                    ShowAlert({
                        title: 'Requisition',
                        text: result.errormsg,
                        icon: 'error',
                    });
                }
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }

