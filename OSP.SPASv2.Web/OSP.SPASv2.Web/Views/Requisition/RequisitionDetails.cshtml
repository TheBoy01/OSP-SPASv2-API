@using Microsoft.AspNetCore.Identity
@using OSP.SPASv2.Web.Areas.Identity.Data
@using Newtonsoft.Json;
@model SPASv2.Models.RequisitionViewModel
@inject SignInManager<OSPSPASv2ApplicationUser> SignInManager
@inject UserManager<OSPSPASv2ApplicationUser> UserManager

@{
    ViewData["Title"] = ViewData["pagetitle"];
    Layout = null;
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"
        integrity="sha256-xLD7nhI62fcsEZK2/v8LsBcb4lG7dgULkuXoXB/j91c="
        crossorigin="anonymous"></script>*@
<style>
    #basic-addon1 {
        width: 150px;
        background-color: #dedcff;
    }

    .input-group {
        margin-bottom: 5px;
    }
</style>



@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

@{
    ReasonModalViewModel DeclineModalModel = new ReasonModalViewModel()
            {
                ModalName = "modalDenyRequest",
                ModalTitle = "Deny Transaction Details",
                SuccessMethod = "ConfirmDenialRequest()",
                lstReason = Model.lstReason.Where(a => a.Category == "DECLINE").ToList(),
                cboReasonId = "cboDenialReason",
                txtReasonRemarksId = "txtDenialRemarksId",
                Instruction = "<a style='color: #012970 !important;'>Please enter reason to deny the transaction!</a>"
            };

    await Html.RenderPartialAsync("_ReasonDetails.cshtml", DeclineModalModel);
    // /Views/Requisition/_ReasonDetails.cshtml
}

@{
    ReasonModalViewModel _voidReasonModal = new ReasonModalViewModel()
            {
                ModalName = "modalVoidRequest",
                ModalTitle = "Void Transaction Details",
                SuccessMethod = "ConfirmVoidRequest()",
                lstReason = Model.lstReason.Where(a => a.Category == "DECLINE").ToList(),
                cboReasonId = "cboVoidReason",
                txtReasonRemarksId = "txtVoidRemarksId",
                Instruction = "<a style='color: #012970 !important;'>Please enter reason to void the transaction!</a>"
            };

    await Html.RenderPartialAsync("_ReasonDetails.cshtml", _voidReasonModal);
    // /Views/Requisition/_ReasonDetails.cshtml
}

@{
    ReasonModalViewModel _rushReasonModal = new ReasonModalViewModel()
            {
                ModalName = "modalVerifyRush",
                ModalTitle = "Rush Reason Details",
                SuccessMethod = "ConfirmVerifyRush()",
                lstReason = Model.lstReason.Where(a => a.Category == "RUSH").ToList(),
                cboReasonId = "cboRushReason",
                txtReasonRemarksId = "txtRushRemarksId",
                Instruction = "<a style='color: #012970 !important;'>Please enter reason to tag transaction as rush!</a>"
            };

    await Html.RenderPartialAsync("_ReasonDetails.cshtml", _rushReasonModal);
    // /Views/Requisition/_ReasonDetails.cshtml
}

@{
    UpdateDetailsModalViewModel _UpdateDetailsModalViewModel = new UpdateDetailsModalViewModel()
            {
                ModalName = "modalUpdateDetails",
                ModalTitle = "Update Requisition Details",
                Instruction = "<a style='color: #012970 !important;'>Please enter details to update.</a>",
                SalesInvoiceNo = "txtSalesInvoiceNo",
                SalesInvoiceDate = "dtpSIDate",
                Deduction = "txtDeduction",
                TotalAmount = "txtTotalAmount",
                Freight = "txtFreight",
                SuccessMethod = "CanUpdateReqDetails()"
            };

    await Html.RenderPartialAsync("_UpdateReqDetails.cshtml", _UpdateDetailsModalViewModel);
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="section dashboard">
    <div class="card mb-10 overflow-auto">
        <div class="card-body">

            @if (Model.isDenied)
            {
                <h2 class="card-title" style="margin-bottom:0px; padding-bottom:0px;"> <center><span style="font-size: x-large;color: #dc3545;border: red;border-color: #f27474;border-width: thick;border-style: double;padding: 3px;margin-bottom: 10px;"> Requisition has been <b>DENIED</b></span></center></h2>
            }

            @if (Model.isDenied)
            {
                <div class="row">
                    <div class="col" style="min-width:300px;">
                        <h2 class="card-title">Denial Details</h2>

                        @if (Model.RequisitionInfo.DenialReason != null)
                        {
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Reason
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.DenialReason.ToUpper()" readonly style="max-width:400px;" />
                            </div>
                        }

                        @if (Model.RequisitionInfo.DenialRemarks != null)
                        {
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Remarks
                                        </span>
                                    </div>

                                </div>

                                @*<textarea class="form-control" style="resize:none"  required @strReadOnly></textarea>*@
                                <textarea class="form-control" style="resize:none; max-width:400px;" readonly>@Model.RequisitionInfo.DenialRemarks.ToUpper()</textarea>
                            </div>
                        }
                    </div>
                </div>
            }


            @if (Model.RequisitionInfo.TransType.ToUpper() == "RSH")
            {
                <div class="row">
                    <div class="col" style="min-width:300px;">
                        <h2 class="card-title" style="margin-bottom:0px; padding-bottom:0px;"> <span style="font-size: large;color: #dc3545;/* border: red; *//* border-color: #f27474; *//* border-width: thick; */border-style: dotted;padding: 3px;margin-bottom: 10px;"> Rush Transaction</span></h2>
                    </div>
                    <div class="col" style="min-width:300px;">
                    </div>
                </div>
            }

            <div class="row">
                <div class="col" style="min-width:300px;">
                    <h2 class="card-title">Request No: <span style="font-size:large; color: #3b2ffb;"> @Model.PRNo.ToUpper()</span></h2>
                </div>
                <div class="col" style="min-width:300px;">
                    <h2 class="card-title">Request Date: <span style="font-size:large; color: #3b2ffb;">@Model.RequisitionInfo.ReqDate.ToString("MM/dd/yyyy")</span></h2>
                </div>
            </div>

            @if (string.IsNullOrEmpty(@Model.RequisitionInfo.SalesInvoiceNo) && Model.RequisitionInfo.ReqNo != Model.RequisitionInfo.MainReqNo)
            {
                <button id="btnUpdateDetails" type="submit" class="btn btn-success" onclick="UpdateDetails()" style="min-width: 200px;">
                    Update Requisition
                </button>
            }


            <div class="row my-2">
                <div class="col">
                    <div class="row">
                        <div class="col" style="min-width:300px;">
                            <h2 class="card-title" style="padding-top: 0px;">Purchase Order Details</h2>

                            @if (@Model.RequisitionInfo.MainReqNo != @Model.RequisitionInfo.ReqNo)
                            {
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">Main Request No:</span>
                                    </div>
                                    <input type="text" class="form-control" value="@Model.RequisitionInfo.MainReqNo" readonly="">
                                    <a class="btn btn-primary" href="/Requisition/Details/@Model.RequisitionInfo.MainReqNo" type="button" data-toggle="tooltip" data-placement="Top" title="View Main Request"><i class="bi bi-eye"></i></a>
                                </div>
                            }


                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        P.O. No.
                                    </span>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.PONo" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        P.O. Date
                                    </span>
                                </div>
                                @if (string.IsNullOrEmpty(@Model.RequisitionInfo.PONo))
                                {
                                    <input class="form-control " value="" readonly />
                                }
                                else
                                {
                                    <input class="form-control " value="@Model.RequisitionInfo.PODate.ToString(" MM /dd/yyyy")" readonly />
                                }

                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">Approval No</span>
                                </div>
                                <input type="text" class="form-control" value="@Model.RequisitionInfo.MainReqApprovalNo" readonly="">
                                <a class="btn btn-primary" href="/Requisition/BatchApprovalDetails/@Model.RequisitionInfo.MainReqApprovalNo" type="button" data-toggle="tooltip" data-placement="Top" title="View Approval"><i class="bi bi-eye"></i></a>
                            </div>


                            <h2 class="card-title">Requester Details</h2>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Name
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.RequesterName" readonly />

                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Company Type
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.RequesterCompanyType" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Department
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.RequesterDepartment" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Address
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.RequesterAddress" readonly />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col">
                    <div class="row">
                        <div class="col" style="min-width:300px;">

                            <h2 class="card-title" style="padding-top: 0px;">Vendor Details</h2>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Payment Class
                                        </span>
                                    </div>
                                </div>

                                <input class="form-control" value="@Model.RequisitionInfo.PayClass" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Supplier
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.Vendor" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Payee Name
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.PayeeName" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Payment Method
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.PayMethod" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Payment Channel
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.PaymentChannel" readonly />
                            </div>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            <label class="form-label"> Account No</label>
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.AccountNo" readonly />
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col" style="min-width:300px;">

                    <h2 class="card-title">Other Details</h2>

                    @if (!string.IsNullOrEmpty(Model.RequisitionInfo.BatchNo))
                    {
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon1">Batch No</span>
                            </div>
                            <input type="text" class="form-control" value="@Model.RequisitionInfo.BatchNo" readonly="">
                            <a class="btn btn-primary" href="/BatchRequisition/Details/@Model.RequisitionInfo.BatchNo" type="button" data-toggle="tooltip" data-placement="Top" title="View Batch"><i class="bi bi-eye"></i></a>
                        </div>
                    }

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon1">
                                    Reference No
                                </span>
                            </div>
                        </div>
                        <input class="form-control" value="@Model.RequisitionInfo.RefNo" readonly />
                    </div>

                    @if (Model.RequisitionInfo.MainReqNo != Model.RequisitionInfo.ReqNo)
                    {
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        Invoice No
                                    </span>
                                </div>
                            </div>
                            <input class="form-control" value="@Model.RequisitionInfo.SalesInvoiceNo" readonly />
                        </div>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        Invoice Date
                                    </span>
                                </div>
                            </div>
                            <input class="form-control" value="@Convert.ToDateTime(Model.RequisitionInfo.SalesInvoiceDate).ToString("MM/dd/yyyy")" readonly />
                        </div>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        Delivery No
                                    </span>
                                </div>
                            </div>
                            <input class="form-control" value="@Model.RequisitionInfo.DeliveryNo" readonly />
                        </div>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        Delivery Date
                                    </span>
                                </div>
                            </div>
                            <input class="form-control" value="@Convert.ToDateTime(Model.RequisitionInfo.DeliveryDate).ToString("MM/dd/yyyy")" readonly />
                        </div>

                    }

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon1">
                                    Remarks
                                </span>
                            </div>

                        </div>

                        @*<textarea class="form-control" style="resize:none"  required @strReadOnly></textarea>*@
                        <textarea class="form-control" style="resize:none" readonly>@Model.RequisitionInfo.Remarks</textarea>
                    </div>
                    @if (Model.RequisitionInfo.TransType.ToUpper() == "RSH")
                    {
                        <h2 class="card-title">Rush Details</h2>

                        @if (Model.RequisitionInfo.RushReason != null)
                        {
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Reason
                                        </span>
                                    </div>
                                </div>
                                <input class="form-control" value="@Model.RequisitionInfo.RushReason.ToUpper()" readonly />
                            </div>
                        }



                        @if (Model.RequisitionInfo.RushRemarks != null)
                        {
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="basic-addon1">
                                            Remarks
                                        </span>
                                    </div>

                                </div>

                                @*<textarea class="form-control" style="resize:none"  required @strReadOnly></textarea>*@
                                <textarea class="form-control" style="resize:none" readonly>@Model.RequisitionInfo.RushRemarks.ToUpper()</textarea>
                            </div>
                        }

                    }

                    @if (@Model.RequisitionInfo.MainReqNo != @Model.RequisitionInfo.ReqNo && (!string.IsNullOrEmpty(Model.RequisitionInfo.ReqApprovalNo)))
                    {
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon1">Approval No</span>
                            </div>
                            <input type="text" class="form-control" value="@Model.RequisitionInfo.ReqApprovalNo" readonly="">
                            <a class="btn btn-primary" href="/Requisition/BatchApprovalDetails/@Model.RequisitionInfo.ReqApprovalNo" type="button" data-toggle="tooltip" data-placement="Top" title="View Approval"><i class="bi bi-eye"></i></a>
                        </div>
                    }
                    <h2 class="card-title">
                        Supporting Documents
                    </h2>

                    <div id="divSupDocs">
                        @{
                            Model.SupDocsListName = "sup1";
                            await Html.RenderPartialAsync("_RequisitionDocs.cshtml", Model);
                        }

                    </div>
                </div>
                <div class="col">

                    <div id="divReqJourney">
                        @{
                            Model.dashboardViewModel.RequestJourneyType = "Request PO Then Pay";
                            await Html.RenderPartialAsync("/Views/Home/_RequestJourney.cshtml", Model.dashboardViewModel);
                        }
                    </div>
                </div>
            </div>

            @if (Model.RequisitionInfo.MainReqNo != Model.RequisitionInfo.ReqNo)
            {
                <hr />
                <div class="row">
                    <div class="col" style="min-width:300px;">
                        <h2 class="card-title">
                            Deduction and Other Charges
                        </h2>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-prepend" style="TEXT-ALIGN: RIGHT;">
                                    <span class="input-group-text" id="basic-addon1">
                                        Deduction
                                    </span>
                                </div>
                            </div>
                            <input class="form-control" required="" style="/* text-transform:uppercase; */TEXT-ALIGN: RIGHT; max-width:247px;" value="@string.Format("{0:N2}", Model.RequisitionInfo.Deduction)" readonly>

                        </div>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-prepend" style="TEXT-ALIGN: RIGHT;">
                                    <span class="input-group-text" id="basic-addon1">
                                        Freight
                                    </span>
                                </div>
                            </div>
                            <input class="form-control" style="/* text-transform:uppercase; */TEXT-ALIGN: RIGHT; max-width:247px;" value="@string.Format("{0:N2}", Model.Freight)" readonly>

                        </div>
                    </div>
                    <div class="col"></div>
                </div>
            }


            <hr />
            <div class="row">
                <div class="col">
                    <h2 class="card-title">
                        Items/Services
                    </h2>

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon1">
                                    Company:
                                </span>
                            </div>
                        </div>
                        <input class="form-control" required="" style="text-align: left;max-width: 400px;" value="@Model.RequisitionInfo.ItemCompany" readonly>
                    </div>

                    <div class="row my-2">
                        <div class="col" style="min-width:300px;">
                            <div id="_tmpPRInventory">
                                @{
                                    Model.showItemBalance = Model.RequisitionInfo.ReqNo == Model.RequisitionInfo.MainReqNo;
                                    Model.showAddItemButton = false;
                                    Model.ItemListName = "t1";
                                }

                                <div class="row my-2">
                                    <div class="form-group">
                                        @await Html.PartialAsync("_RequisitionItemsList", Model)
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col">
                        </div>
                        <div class="col">
                            <center>
                                @if (Model.isverify)
                                {

                                    if (Model.forapproval == "VERIFIER" || Model.forapproval == "APPROVER")
                                    {
                                        <button id="btnDeny" class="btn btn-danger" style="min-width: 200px; margin-bottom:5px;" onclick="ShowDenyReason()">
                                            <i class="bi bi-hand-thumbs-down-fill"></i>
                                            Deny
                                        </button>

                                        <button id="Verify" type="submit" class="btn btn-primary" onclick="Verify()" style="min-width: 200px; margin-bottom:5px;">
                                            <i class="bi bi-hand-thumbs-up-fill"></i>
                                            @Model.lblAuth
                                        </button>
                                    }
                                    else if (Model.forapproval == "REQUESTER-VALIDATION")
                                    {
                                        <input type="submit" value="Submit Requisition" class="btn btn-primary center" id="submit" style="min-width: 200px;">
                                    }
                                }

                                @if (Model.CanVoid)
                                {
                                    <button id="btnVoid" type="submit" class="btn btn-danger" onclick="Void()" style="min-width: 200px;">
                                        Void Requisition
                                    </button>

                                }
                            </center>
                        </div>
                        <div class="col">
                        </div>
                    </div>

                    @if (Model.RequisitionInfo.ReqNo == Model.RequisitionInfo.MainReqNo && (!String.IsNullOrEmpty(Model.RequisitionInfo.PONo)))
                    {
                        <div class="row">
                            <div class="col" style="min-width:300px;">
                                @*<a class="float-right btn btn-outline-primary" >Create Payment</a>*@
                                @if (Model.isCreatePaymentBtn)
                                {
                                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("SPASV2-Requester"))
                                    {
                                        <a href="#PaymentRequisitionEntry" class="btn btn-sm btn-outline-primary" onclick="DisplayPaymentForm()"><i class="bi bi-plus-circle me-1"></i> Create Payment</a>
                                    }

                                }
                                <h2 class="card-title" style="padding-bottom: 0px;"> Payment Request Details </h2>

                                @if (Model.PaymentRequisitionInfoList.Count == 0)
                                {
                                    <div style="background-color: #dedcff; padding: 10px;">
                                        No Payment Request Found
                                    </div>
                                }
                                <div class="accordion" id="accordionExample">
                                    @{
                                        int i = 2;
                                    }
                                    @foreach (var ReqInfo in Model.PaymentRequisitionInfoList)
                                    {
                                        string prno = ReqInfo.ReqNo;
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingOne">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@prno" aria-expanded="false" aria-controls="collapseOne">
                                                    <b>PR No: </b>
                                                    <b style="margin-left:10px; margin-right:10px; color:green;">@prno -</b>

                                                    <span class="badge" style="
                                                      background-color: #dcffdc;
                                                      color: green; font-size:14px; text-wrap: balance;">
                                                        @ReqInfo.Status
                                                    </span>
                                                </button>

                                            </h2>
                                            <div id="@prno" class="accordion-collapse collapse " aria-labelledby="headingOne" data-bs-parent="#accordionExample" style="">
                                                <div class="accordion-body" style="background-color:#f6f6ff;">

                                                    <div class="row my-2">
                                                        <div class="col" style="min-width:300px">
                                                            <h2 class="card-title">Details </h2>
