    function DisplayPaymentForm() {
        document.getElementById("secPaymentEntry").style.display = "block";
        var ReqNo = @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionInfo.MainReqNo));

        $.ajax({
            type: "POST",
            url: "/Requisition/GetCreatePaymentForm",
            data: { ReqNo: ReqNo },
            dataType: 'html',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                $("#PaymentRequisitionEntry").html(result);
                location.href = "#gohere";
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");


            }
        });
    }

    function ShowDenyReason() {

        $("#modalDenyRequest").modal("show");
    }


