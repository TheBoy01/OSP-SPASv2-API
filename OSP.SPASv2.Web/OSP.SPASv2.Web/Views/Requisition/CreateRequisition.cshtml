<script>

    var items;
    var reqItems = [];
    var canAddItem;

    isModelValidate = @Html.Raw(JsonConvert.SerializeObject(Model.isModelValidated));
    items = @Html.Raw(JsonConvert.SerializeObject(Model.VendorItemList));
    reqItems = @Html.Raw(JsonConvert.SerializeObject(Model.RequisitionItemList));
    

    $(document).ready(function () {
        DisplayValidationWithText("Requisition", "Unable to create, there was an error in your submission!");
    });

    $('#btnReqAttachment').click(function () {
        $('#inpReqAttachment').click();
    });

    $('#btnPyReqAttachment').click(function () {
        $('#inpPyReqAttachment').click();
    });

    function SetPayClassVendor() {
        if (reqItems.length > 0) {
            alert("clear");
            reqItems = [];
            RefreshItemList();
        }

        ClearSupplierDetails();

        var inputSupplier = $('#Supplier').val();
        var inputpayclass = $("#cboPayClass").val();
        $.ajax({
            type: "GET",
            url: '/Requisition/GetVendorLists',
            data: {
                vendordesc: inputSupplier,
                paymentclass: inputpayclass
            },
            dataType: "json",
            success: function (result) {

                var data = result.data;

                var s = '';
                for (var i = 0; i < data.length; i++) {
                    console.log(data[i])
                    s += '<option value="' + data[i].VendorName + '" data-value="' + data[i].VendorCode + '"></option>';
                }
                $("#dtVendorList").html(s);

                $("#JourneyType").html(result.ClassDesc);
            },


            error: function (response) {
                alert(response.responseText);
            },
            failure: function (response) {
                alert("failure " + response.responseText);
            }

        });

    }

    function ClearSupplierDetails() {
        document.getElementById('Supplier').value = "";
        document.getElementById('PCVName').value = "";
        document.getElementById('PaymentMethod').value = "";
        document.getElementById('PaymentNetwork').value = "";
        document.getElementById('Destination').value = "";

    }

    $("#Supplier").on('input', function () {
        var inputpayclass = $("#cboPayClass").val();

        var textval = $('#Supplier').val();
        var vendorcode = $('#dtVendorList [value="' + textval + '"]').data('value');
        $("#SupplierCode").val(vendorcode);

        $.ajax({
            type: "GET",
            url: "/Requisition/GetVendorDetails/",
            data: {
                vendorcode: vendorcode,
                payclass: inputpayclass
            },
            success: function (data) {
                $('#Destination').val(data.vendordtl.AccountNo);
                $('#PaymentMethod').val(data.vendordtl.PaymentMethod);
                $('#PaymentNetwork').val(data.vendordtl.BankCode);
                $('#PCVName').val(data.vendordtl.PayeeName);

                var s = '';

                items = data.itemList;
                for (var i = 0; i < items.length; i++) {
                    s += '<option value="' + items[i].ItemDesc + '" data-value="' + items[i].ItemCode + '"></option>';
                }
                $("#dtItemList").html(s);


            }, error: function (response) {
                alert(response.responseText);
            },
            failure: function (response) {
                alert("failure " + response.responseText);
            }
        });


    });

    function ReadDocs(input) {


        var fileData = new FormData();
        var files = $("#inpReqAttachment")[0].files;
        for (var i = 0; i < files.length; i++) {
            fileData.append("files", files[i]);
        }

        $.ajax({
            type: "POST",
            url: "/Requisition/SetDocs",
            processData: false,
            contentType: false,
            data: fileData,
            dataType: 'html',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                $("#divSupDocs").html(result);
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });

        if (files.length > 0) {
            document.getElementById("ResetDocs").style.display = "inline-block";
            document.getElementById("btnReqAttachment").style.display = "none";
        }
        else {
            document.getElementById("btnReqAttachment").style.display = "inline-block";
            document.getElementById("ResetDocs").style.display = "none";
        }
    }

    function ResetDocs() {

        ShowAlert(
            {
                title: "Are you sure?",
                text: "All selected files will be removed!",
                icon: "question",
                showCancelButton: "true",
                confirmButtonText: "Yes!",
                successmethod: "ConfirmReset()"
            });
    }

    function ConfirmReset() {
        $('#inpReqAttachment').val("");
        ReadDocs();
    }

    function SetItemDetails() {

        var textval = $('#ItemDesc').val();
        var itemCode = $('#dtItemList [value="' + textval + '"]').data('value');

        var found = 0;
        for (var i = 0; i < items.length; i++) {
            if (items[i].ItemCode == itemCode) {
                var amt = items[i].Amount.toLocaleString("en-US", { maximumFractionDigits: 2, minimumFractionDigits: 2 });

                $('#UOM').val(items[i].UOM);
                $('#ItemPrice').val(amt);
                found = 1;
                break;
            }
        }

        if (found == 0) {
            $('#UOM').val("");
            $('#ItemPrice').val("0.00");
        }
    }

    function AddItem() {
        var itemDesc = $('#ItemDesc').val();
        var itemCode = $('#dtItemList [value="' + itemDesc + '"]').data('value');

        var Company = $("#Company").val();
        var DeptDesc = $("#Code option:selected").text();
        var Code = $("#Code").val();
        var Quantity = $("#Quantity").val();
        var Discountprice = $("#Discountprice").val();
        var DiscountCode = $("#Discount").val();

        var InputItem = 
        {
            CompanyType: Company,
            DeptDesc: DeptDesc,
            DeptCode: Code,
            ItemCode: itemCode,
            Item: itemDesc,
            Quantity: Quantity,
            DiscountCode: DiscountCode,
            Discount: Discountprice
        };

        $.ajax({
            type: "POST",
            url: "/Requisition/CanAddItem",
            data: { itemList: JSON.stringify(reqItems), item: JSON.stringify(InputItem) },
            dataType: 'json',
            beforeSend: function () {
                ShowLoader();
                $("#modalItem").modal("hide");
            },
            success: function (result) {

                if (!result.success) {
                    ShowAlert(
                        {
                            title: "Requisition",
                            text: result.error,
                            icon: "error",
                            successmethod: "ShowModalItem()"
                        });

                }
                else
                {
                    pushAddItem(InputItem);
                }   
                

            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }

    function pushAddItem(InputItem) {
        reqItems.push(InputItem);

        $("#modalItems").modal("hide");

        ShowAlert(
            {
                title: "Requisition",
                text: "Item/service successfully added!",
                icon: "success",
                successmethod: "RefreshItemList()"
            });
    }

    function ShowModalItem()
    {
        $("#modalItems").modal("show");
    }

    function RefreshItemList() {

        document.getElementById('frmAddItems').reset();

        var supval = $('#Supplier').val();
        var vendorcode = $('#dtVendorList [value="' + supval + '"]').data('value');        
        var payclass = $("#cboPayClass").val();

        $("#RequisitionItemList").val(JSON.stringify(reqItems));
        $("#SupplierCode").val(vendorcode);

        $.ajax({
            type: "POST",
            url: "/Requisition/GenerateItemList",
            data: { item: JSON.stringify(reqItems), vendorcode: vendorcode, deduction: 0, freight: 0, isCreatePayment: false, payclass: payclass },
            dataType: 'html',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                $("#divItemList").html(result);
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }

    function SetDiscountType() {
        var DiscountCode = $("#Discount").val();

        if (DiscountCode == '') {
            $("#Discountprice").attr("readonly", true);
            $("#Discountprice").val("0");
        }
        else {
            $("#Discountprice").attr("readonly", false);
        }
    }

    function DisplayPO() {

        var PONo = $('#txtPONo').val();
        $.ajax({
            type: "POST",
            url: "/Requisition/SearchPO",
            data: { PONo: PONo },
            dataType: 'html',
            beforeSend: function () {
                ShowLoader();
            },
            success: function (result) {
                $("#divRequisitionList").html(result);
                $("#modalPOSearch").modal("show");
            },
            error: function (xhr, status, error) {

            },
            complete: function (data) {
                $("#loader").modal("hide");
            }
        });
    }



</script>