<script type="text/javascript">

    var isModelValidate;

    function DisplayValidationWithText(title, text) {
        if (isModelValidate) {
            document.querySelectorAll('.alertVal').forEach(function (element) {
                if ($('span:first', element).text() != "") {
                    element.classList.remove("alertValHide");
                }
            });
            ShowAlert(
                {
                    title: title,
                    text: text,
                    icon: "error"
                });
        }
    }

    function DisplayValidation() {
        if (isModelValidate) {
            document.querySelectorAll('.alertVal').forEach(function (element) {
                if ($('span:first', element).text() != "") {
                    element.classList.remove("alertValHide");
                }
            });
        }
    }

    function ShowLoader()
    {
        $("#loader").modal({ backdrop: "static" });
        $("#loader").modal("show");
    }

    function HideLoader() {
        $("#loader").modal("hide");
    }


