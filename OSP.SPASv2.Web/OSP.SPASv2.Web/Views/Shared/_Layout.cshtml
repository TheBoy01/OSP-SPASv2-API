    function ShowImage(imageUrl, imageTitle, isImage) {

        if (isImage) {
            $('#modalImage').attr('src', imageUrl);
            $("#modalIframe").attr("hidden", true);
            $("#modalImage").attr("hidden", false);
        }
        else {

            $('#modalIframe').attr('src', imageUrl);
            $("#modalIframe").attr("hidden", false);
            $("#modalImage").attr("hidden", true);
        }

        $('#spanImgTitle').text(imageTitle)
        $('#imageModal').modal("show");
        $('#btnImgDownload').attr('href', imageUrl);
        $('#btnImgDownload').attr('download', imageTitle);



    }


    function DisplayAttachment(imageUrl, imageTitle, isImage) {
        $.ajax({
            type: "Post",
            url: '/Requisition/DisplayAttachment',
            data: {
                url: imageUrl,
            },
            dataType: "json",
            success: function (result) {

                var urlLoc = "/Requisition/DocumentViewer?url=" + result.url;
                var myWindow = window.open(urlLoc, '_blank');
            },
        });




    }

    function capitalizeEachWord(str) {
        if (!str) return '';
        return str
            .toLowerCase() // Convert the whole string to lowercase
            .split(' ') // Split the string into words
            .map(word => word.charAt(0).toUpperCase() + word.slice(1)) // Capitalize the first letter of each word
            .join(' '); // Join the words back into a single string
    }

