<script type="text/javascript">
    
    
    @*ChangeNav();*@

    $('.linkbutton').click(function (e) {
        e.preventDefault();
    });

    function ValidateReason(rescode, remarks, process) {
        if (rescode == '') {
            ShowAlert({
                title: 'Requisition',
                text: "Please select reason to " + process + " requisition.",
                icon: 'error',
            });

            return false;
        }


        if (remarks == '') {
            ShowAlert({
                title: 'Requisition',
                text: "Please enter remarks to " + process + " requisition.",
                icon: 'error',
            });

            return false;
        }

        return true;
    }

    function ExecuteMethod(method) {
        var codeToExecute = method;
        var tmpFunc = new Function(codeToExecute);
        tmpFunc();
    }


    function ShowAlert(AlertProp)
    {
        $.ajax({
            url: '/Utility/ShowAlert',
            type: 'GET',
            dataType: 'html',
            data: { alertval: JSON.stringify(AlertProp) },
            success: function (response) {
                $("#AlertBody").html(response);
                $("#MyAlert1").addClass("md-show");
