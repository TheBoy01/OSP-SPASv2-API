                <li class="dropdown-header text-start">
                    <h6>Filter</h6>
                </li>
                <li><a class="dropdown-item linkbutton" href="#" onclick="SetFilter('Vendor')">Vendor</a></li>
                <li><a class="dropdown-item linkbutton" href="#" onclick="SetFilter('Payclass')">Payclass</a></li>
                <li><a class="dropdown-item linkbutton" href="#" onclick="SetFilter('Company')">Company</a></li>
                <li><a class="dropdown-item linkbutton" href="#" onclick="SetFilter('ItemsPaid')">Items Paid</a></li>
            </ul>
        </div>
    <div class="card-body">
            <h5 class="card-title">Top 10 Request <span>| by <span class="spanFilter">Vendor</span></span></h5>
            <div class="" style="display:inline;">
                as of
                <select class="form-select" onchange="SetSorting(this)" style="width: auto;display: inline; font-size:small;">
                    <option value="ThisMonth">This Month</option>
                    <option value="PreviousMonth">Previous Month</option>
                    <option value="ThisYear">This Year</option>
                </select>
            </div>
            
            <!-- Bar Chart -->  
            @*<div id="divchart">
