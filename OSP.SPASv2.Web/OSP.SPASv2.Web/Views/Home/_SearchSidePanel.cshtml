@*<div class="col-lg-4">*@

    <!-- Recent Activity -->
    <div class="card">
        <div class="filter">
            <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                <li class="dropdown-header text-start">
                    <h6>Filter</h6>
                </li>

                <li><a class="dropdown-item" href="#">Today</a></li>
                <li><a class="dropdown-item" href="#">This Month</a></li>
                <li><a class="dropdown-item" href="#">This Year</a></li>
            </ul>
        </div>

        <div class="card-body">
            <h5 class="card-title"><i class="bx bx-search-alt-2"></i>Requisition Tracker</h5>
            <form class="row g-3 mb-2" id="frmSearch">
                <div class="col-12">
                    @*<label for="inputNanme4" class="form-label">Enter Request No.</label>
                    <input type="text" class="form-control" id="inputNanme4">*@
                    <div class="form-floating">
                        <input type="text" class="form-control" id="txtRequestNo" name="txtRequestNo" placeholder="Request No.">
                        <label for="floatingName"> Your Request / Reference/ Approval No.</label>
                    </div>
                </div>
                <div class="text-center">
                    <button type="button" id="btnSearch" onclick="SearchRequisition();" class="btn btn-primary">Search</button>
                    <button type="reset" class="btn btn-secondary" onclick="ClearRequisition();">Clear</button>
                </div>
            </form>
            <div id="divReqJourney">
                @{
                    Model.isStartUp = true;
                    await Html.RenderPartialAsync("_RequestJourney", Model);
                }
            </div>

        </div>
    </div><!-- End Recent Activity -->

@*</div>*@

<script type="text/javascript">

    var input = document.getElementById("txtRequestNo");
    input.addEventListener("keypress", function (event) {
        if (event.key === "Enter") {
            event.preventDefault();
            document.getElementById("btnSearch").click();
        }
    });


    function SearchRequisition()
    {
        var txt = $('#txtRequestNo').val();

        LoadRequestJourney(txt);
    }

    function ClearRequisition() {

        LoadRequestJourney("");
    }

    function LoadRequestJourney(txt)
    {
        $.ajax({
            url: '/Home/SearchRequest',
            type: 'GET',
            dataType: 'html',
            data: { RequestNo: txt },
            success: function (response) {
                $("#divReqJourney").html(response);
            },
            error: function () {
                alert('Error getting products');
            }
        });
    }

</script>
