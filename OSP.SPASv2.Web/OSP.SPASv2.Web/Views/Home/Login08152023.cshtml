    </main><!-- End #main -->

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>


    <script type="text/javascript">
        $(function () {
            $("#btnLogin_").click(function () {
                var model =
                {
                    Username: document.getElementById("yourUsername").value,
                    Password: document.getElementById("yourPassword").value
                };


                $.ajax({
                    type: "POST",
                    url: '/Home/Login',
                    data: { Login: model },
                    dataType: 'json',
                    success: function (response) {
                        document.getElementById("testpartial").innerHTML = response.v1;
                        document.getElementById("testpartial2").innerHTML = response.v2;

                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            });

            $("#btnTest").click(function () {
                $.ajax({
                    url: '/Home/TestResponse',
                    type: 'GET',
                    dataType: 'html',
                    success: function (data) {
                        alert(data.ErrorMessage);
                    },
                    error: function () {
                        alert('Error getting products');
                    }
                });
            });
        });
    </script>

