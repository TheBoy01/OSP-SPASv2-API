                                <label asp-for="TblVendor.MiddleName" class="control-label required">Middle Name</label>
                                <input asp-for="TblVendor.MiddleName" class="form-control" id="MiddleName" />
                                <span asp-validation-for="TblVendor.MiddleName" class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="TblVendor.Suffix" class="control-label required">Suffix</label>
                                <input asp-for="TblVendor.Suffix" class="form-control" id="Suffix" />
                                <span asp-validation-for="TblVendor.Suffix" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

