@model SPASv2.Models.VendorMaintenanceModel

@{
    ViewData["Title"] = "Create Vendor";
}
@*
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.0/jquery.min.js"></script>*@
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>*@
@*<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>*@
@*<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />*@

@*<script src="~/js/vendormodule/main.js" type="text/javascript"></script>*@

<form id="CreateVendor">

    <main id="main" class="main">
        <section class="section dashboard">

            <div class="card">
                <div class="card-body">
                    <h1 id="Testing_return">Vendor Maintenance</h1>
                    <h4>Create Vendor</h4>
                    <hr />

                    <div class="row">
                        <div class="col-4">
                            <label asp-for="VendorTypeList" class="control-label required"></label>
                            @Html.DropDownListFor(model => model.VendorTypeList,Model.VendorTypeList.Select(m => new SelectListItem { Value = m.VendorTypeCode, Text = m.VendorTypeDesc }), "-- SELECT PAYMENT TYPE --", htmlAttributes: new { @class = "form-select",@id = "VendorType" })
                            <span asp-validation-for="TblVendor.VendorType" class="text-danger"></span>
                        </div>
                        <div class="col" id="DisplayNameDiv" style="display:none;">
                            <label asp-for="TblVendor.DisplayName" class="control-label required">Vendor Name</label>
                            <input asp-for="TblVendor.DisplayName" class="form-control" id="VendorName" />
                            <span asp-validation-for="TblVendor.DisplayName" class="text-danger"></span>
                        </div>
                        <div class="col" id="EmployeeDiv" style="display:none;">
                            <div class="row">
                                <div class="col-sm">
                                    <label asp-for="TblVendor.LastName" class="control-label required">Last Name</label>
                                    <input asp-for="TblVendor.LastName" class="form-control" id="LastName" />
                                    <span asp-validation-for="TblVendor.LastName" class="text-danger"></span>

                                </div>
                                <div class="col-sm">
                                    <label asp-for="TblVendor.FirstName" class="control-label required">First Name</label>
                                    <input asp-for="TblVendor.FirstName" class="form-control" id="FirstName" />
                                    <span asp-validation-for="TblVendor.FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-sm">
                                    <label asp-for="TblVendor.MiddleName" class="control-label required">Middle Name</label>
                                    <input asp-for="TblVendor.MiddleName" class="form-control" id="MiddleName" />
                                    <span asp-validation-for="TblVendor.MiddleName" class="text-danger"></span>
                                </div>
                                <div class="col-md-2">
                                    <label asp-for="TblVendor.Suffix" class="control-label required">Suffix</label>
                                    <input asp-for="TblVendor.Suffix" class="form-control" id="Suffix" />
                                    <span asp-validation-for="TblVendor.Suffix" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row my-2">
                        <div class="col-md-8" id="DisplayNameDiv">
                            <label class="control-label required">Payee Name</label>
                            <input asp-for="TblVendor.DisplayName" class="form-control" id="VendorName" />
                            <span asp-validation-for="TblVendor.DisplayName" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    @* <h5 class="card-title">Vertical Pills Tabs</h5>*@
                    <div class="row">

                        <!-- Vertical Pills Tabs -->
                        <div class="d-flex align-items-start">
                            <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">

                                <button class="nav-link active" id="v-pills-AttachedDocs-tab" data-bs-toggle="pill" data-bs-target="#v-pills-AttachedDocs" type="button" role="tab" aria-controls="v-pills-AttachedDocs" aria-selected="true">Attached Documents</button>
                                <button class="nav-link" id="v-pills-RequiredDocs-tab" data-bs-toggle="pill" data-bs-target="#v-pills-RequiredDocs" type="button" role="tab" aria-controls="v-pills-RequiredDocs" aria-selected="false">Required Documents</button>
                                <button class="nav-link" id="v-pills-ATCList-tab" data-bs-toggle="pill" data-bs-target="#v-pills-ATCList" type="button" role="tab" aria-controls="v-pills-ATCList" aria-selected="false">ATC List</button>
                                <button class="nav-link" id="v-pills-Address-tab" data-bs-toggle="pill" data-bs-target="#v-pills-Address" type="button" role="tab" aria-controls="v-pills-Address" aria-selected="false">Addresses</button>
                                <button class="nav-link" id="v-pills-TIN-tab" data-bs-toggle="pill" data-bs-target="#v-pills-TIN" type="button" role="tab" aria-controls="v-pills-TIN" aria-selected="false">TIN List</button>
                                <button class="nav-link" id="v-pills-Contacts-tab" data-bs-toggle="pill" data-bs-target="#v-pills-Contacts" type="button" role="tab" aria-controls="v-pills-Contacts" aria-selected="false">Contact Details</button>
                                <button class="nav-link" id="v-pills-PaymentMethod-tab" data-bs-toggle="pill" data-bs-target="#v-pills-PaymentMethod" type="button" role="tab" aria-controls="v-pills-PaymentMethod" aria-selected="false">Payment Method</button>
                            </div>

                            <div class="tab-content w-100" id="v-pills-tabContent">

                                <div class="tab-pane fade show active" id="v-pills-AttachedDocs" role="tabpanel" aria-labelledby="v-pills-AttachedDocs-tab">
                                    <h2 class="card-title center">Attached Documents per Payclass</h2>
                                    <hr />
                                    <a class="bi bi-plus-circle fa-2x" id="AddVendorDocs"></a>

                                    <table class="table" id="Tbl_AttachedDoc">
                                        <thead>
                                            <tr>
                                                <th hidden>
                                                    DocType
                                                </th>
                                                <th>
                                                    Documents
                                                </th>
                                                <th>
                                                    Action
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="AttachedDoc_Tbody">
                                        </tbody>
                                    </table>
                                </div>

                                <div class="tab-pane fade" id="v-pills-RequiredDocs" role="tabpanel" aria-labelledby="v-pills-RequiredDocs-tab">
                                    <h2 class="card-title center">Required Documents</h2>
                                    <hr />

                                    <a class="bi bi-plus-circle fa-2x" id="AddVendorRequiredDocs"></a>

                                    <table class="table" id="Tbl_VendorRequiredDocs">
                                        <thead>
                                            <tr>
                                                <th hidden>
                                                    DocType
                                                </th>
                                                <th hidden>
                                                    FilePath
                                                </th>
                                                <th>
                                                    FileName
                                                </th>
                                                <th>
                                                    File Type
                                                </th>
                                                <th>
                                                    Validity
                                                </th>
                                                <th>
                                                    Action
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="Tbody_VendorRequiredDocs">
                                        </tbody>
                                    </table>
                                </div>

                                <div class="tab-pane fade" id="v-pills-ATCList" role="tabpanel" aria-labelledby="v-pills-ATCList-tab">
                                    <h2 class="card-title center">ATC List</h2>
                                    <hr />
                                    <div class="row">
                                        <span><a class="bi bi-plus-circle fa-2x" id="AddVendorATC"></a></span>
                                        <table class="table" id="Tbl_VendorATC">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        ATC
                                                    </th>
                                                    <th>
                                                        Description
                                                    </th>
                                                    <th>
                                                        Rate
                                                    <th>
                                                        VAT
                                                    </th>
                                                    <th>
                                                        Default
                                                    </th>
                                                    <th>
                                                        Action
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody id="Tbody_VendorATC">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="v-pills-Address" role="tabpanel" aria-labelledby="v-pills-Address-tab">
                                    <h2 class="card-title center">Addresses</h2>
                                    <hr />
                                    <div class="row">
                                        @*<span> <a class="bi bi-plus-circle fa-2x" id="CreateAddressModal"></a> </span>*@
                                        <span><a class="bi bi-plus-circle fa-2x" id="AddVendorAddress"></a></span>

                                        <table class="table" id="Address_DataTable">
                                            <thead>
                                                <tr>
                                                    @* <th>
                                                    @Html.DisplayName("")
                                                    </th>*@
                                                    <th>
                                                        @Html.DisplayName("Address Type")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Address")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Zip Code")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Default")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Action")
                                                    </th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody">

                                                <tr>
                                                    <td>
                                                        @Html.DisplayName("BUSINESS")
                                                    </td>
                                                    <td>
                                                        #15 Bantay St., Brgy. Bago, Q.C
                                                    </td>
                                                    <td>
                                                        @Html.DisplayName("11535")
                                                    </td>
                                                    <td>
                                                        @Html.DisplayName("Yes")
