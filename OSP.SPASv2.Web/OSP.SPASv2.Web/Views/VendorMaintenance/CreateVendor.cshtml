                                                    <td>
                                                        <a data-bs-toggle="modal" data-bs-target="#Address_Modal_Edit"> <i class="bi bi-pencil-square fa-lg"></i> </a>
                                                        <a data-bs-toggle="modal" data-bs-target="#Delete"> <i class="bi bi-x-square fa-lg" aria-hidden="true" style="color:red"></i> </a>
                                                    </td>
                                                </tr>

                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="v-pills-TIN" role="tabpanel" aria-labelledby="v-pills-TIN-tab">
                                    <h2 class="card-title center">TIN List</h2>
                                    <hr />
                                    <div class="row">
                                        <span><a class="bi bi-plus-circle fa-2x" aria-hidden="true" data-bs-toggle="modal" data-bs-target="#ATC_Modal"></a></span>
