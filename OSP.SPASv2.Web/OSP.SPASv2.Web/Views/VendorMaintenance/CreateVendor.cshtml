                                        </table>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="v-pills-Contacts" role="tabpanel" aria-labelledby="v-pills-Contacts-tab">
                                    <h2 class="card-title center">Contact Details</h2>
                                    <hr />
                                    <div class="row">
                                        <span><a class="bi bi-plus-circle fa-2x" aria-hidden="true" data-bs-toggle="modal" data-bs-target="#ATC_Modal"></a></span>
                                        <table class="table ">
                                            <thead>
                                                <tr>
