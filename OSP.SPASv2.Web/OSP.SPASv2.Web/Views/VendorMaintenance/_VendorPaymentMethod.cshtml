@model SPASv2.Models.VendorMaintenanceModel

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Edit Bank Account</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">

        <form class="row g-3">
            <div class="col-md-6">
                <label for="inputName5" class="form-label">Account Type</label>
                <select id="inputState" class="form-select">
                    <option selected>SAVINGS</option>
                    <option>CHECKING</option>
                </select>
            </div>
            <div class="col-md-6">
            </div>
            <div class="col-md-6">
                <label for="inputPassword5" class="form-label">Bank Code</label>
                <input type="text" class="form-control" id="inputPassword5">
            </div>
            <div class="col-md-6">
                <label for="inputPassword5" class="form-label">Account Number</label>
                <input type="text" class="form-control" id="inputPassword5">
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="gridCheck">
                    <label class="form-check-label" for="gridCheck">
                        Default
                    </label>
                </div>
            </div>
        </form><!-- End Multi Columns Form -->

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Add</button>
    </div>
</div>