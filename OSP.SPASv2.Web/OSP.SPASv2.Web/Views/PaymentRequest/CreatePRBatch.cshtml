@model IEnumerable<SPASv2.Models.PaymentRequestModel>

@{
    ViewData["Title"] = "Create Payment Request Batch";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main id="main" class="main">
    <section class="section">
        <div class="card mb-10">
            <div class="card-body">
                <h2 class="card-title center">Payment Batch Requisition</h2>
                <button type="button" class="btn btn-info"><i class="bi bi-cloud-download me-1"></i>Download Template</button>
                <hr />
                <label for="myfile">Select a file:</label>
                <input type="file" id="myfile" name="myfile"><br/>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="card-title center">Uploaded List</h2>
                <hr />
                <div class="row"> 
                    <table class="table" id="Bank_DataTable">
                        <thead>
                            <tr>
                                @*<th>
                                    @Html.DisplayName("Company")
                                </th> *@
                                <th>
                                    @Html.DisplayName("Payment Class")
                                </th>
                                 <th>
                                    @Html.DisplayName("Vendor Name")
                                </th> 
                                <th>
                                    @Html.DisplayName("AmountDue")
                                </th>
                                <th>
                                    @Html.DisplayName("Company Type")
                                </th> 
                                <th>
                                    @Html.DisplayName("Branch")
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                @*<td scope="col">FAMILY CHOICE MEMORIAL CHAPELS , INC.</td>*@
                                <td scope="col">REPAIRS AND MAINTENANCE(OTHERS)</td>
                                <td scope="col">BLACKHOUNDS SECURITY AND INVESTIGATION AGENCY INC.</td> 
                                <td scope="col">100,000</td>
                                <td scope="col">CHAPEL</td>
                                <td scope="col">MAYON</td>
                            </tr>
                             <tr>
                                @*<td scope="col">FAMILY CHOICE MEMORIAL CHAPELS , INC.</td>*@
                                <td scope="col">TUITION FEE</td>
                                <td scope="col">RON ALLAN</td> 
                                <td scope="col">2,000</td>
                                <td scope="col">BRANCH</td>
                                <td scope="col">MO</td>
                            </tr>
                        </tbody>
                    </table> 
                   
                </div>
                <button type="button" class="btn btn-primary">Upload</button>
            </div>
        </div> 

    </section>
</main>


