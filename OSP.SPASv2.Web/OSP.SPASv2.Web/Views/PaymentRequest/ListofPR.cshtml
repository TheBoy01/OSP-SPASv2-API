                    </thead>
                    <tbody>
                        @foreach (var item in Model.dashboardViewModel.RequestList)
                        {
                            <tr>
                                <td scope="row"><a href="@Url.Action("ViewPR", "PaymentRequest",new { prno=item.RequestID})">@Convert.ToString(item.RequestID)</a></td>
                                <td>
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#">View</a></li>
                                            <li><a class="dropdown-item" href="#">Delete</a></li>
                                            <li><a class="dropdown-item" href="#">Payment</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td scope="row"><a href="@Url.Action("ViewPR", "PaymentRequest",new { prno=item.RequestID})">@Convert.ToString(item.RequestID)</a></td>
                                <td class="money">
                                    <div class="currencySymbol">
                                        &#8369 @string.Format("{0:#,0.00##}", item.Amount)
                                    </div>

                                </td>
                                <td>

                                    @switch (item.Status.ToUpper())
                                    {
                                        case "APV PREPARATION":
                                        case "FOR POSTING":
                                        case "FOR CREDITATION":
                                        case "APPROVED":
                                        case "VERIFIED":
                                        case "FOR PAYMENT":
                                        default:
                                            {
                                                <span class="badge" style="
                                                      background-color: #dcffdc;
                                                      color: green; font-size:14px;">
                                                    @item.Status
                                                </span>
                                                break;
                                            }

                                    }


                                </td>
                                <td>@item.Vendor</td>

                                <td>

                                    @item.RequestDate.ToString("MM/dd/yyyy h:mm tt")
                                </td>
                                <td>@item.PayClass</td>
                            </tr>
                        }

