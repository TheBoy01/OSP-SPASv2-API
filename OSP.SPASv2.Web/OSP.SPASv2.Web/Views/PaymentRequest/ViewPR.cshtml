    //        var imageUrl = $(this).data('image-url');
    //        $('#modalImage').attr('src', imageUrl);
    //    });
    //});

    $(document).ready(function () {
        $('a[data-toggle="modal"]').on('click', function () {
            var imageUrl = $(this).attr('href'); // Get the URL from the link's href
            $('#modalImage').attr('src', imageUrl);
        });


    });

    function ShowImage(imageUrl) {
        
        $('#modalImage').attr('src', imageUrl);
        $('#imageModal').modal("show");
       
    }

    function SearchRequisition() {
        var txt = $('#txtRequestNo').val();

        LoadRequestJourney(txt);
    }

    function ClearRequisition() {

        LoadRequestJourney("");
    }

    function LoadRequestJourney(txt) {
        $.ajax({
            url: '/Home/SearchRequest',
            type: 'GET',
            dataType: 'html',
            data: { RequestNo: txt },
            success: function (response) {
                $("#divReqJourney").html(response);
            },
            error: function () {
                alert('Error getting products');
            }
        });
    }

    function Verify() {
        Swal.fire({
            title: 'Verify',
            text: "Are you sure you want to verify?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Confirm"
        }).then((result) => {
            if (result.value) {

                // $('#Verify').submit();
                var hidprno = $("#PRNoID").val();
                var sforapproval = $("#Verify").val();
                $.ajax({
                    url: '/PaymentRequest/VerifyPaymentRequest',
                    type: 'POST',
                    //dataType: 'html',
                    data: { prno: hidprno, verify:sforapproval },
                    success: function (result) {
                        
                        //alert(result.success);
                        JSalert(result.success, result.errormsg)

                    },
                    error: function () {
                        alert('Error getting products');
                    }
                });
            }
        })
    }

    $(document).ready(function () {
        $("#UploadFiles").click(function () {
            var hidprno = $("#PRNoID").val();
            var fileData = new FormData();
            var files = $("#FileInput")[0].files;
            for (var i = 0; i < files.length; i++) {
                fileData.append("files", files[i]);
            }
            fileData.append("PRNoID", hidprno);
            //var dataToSend = {
            //    prno: hidprno,
            //    files: fileData
            //};

            //fileData.append("hiddenFieldName", "YourHiddenValue");
            //fileData.append("fileInput", $("#fileInput")[0].files[0]);
            //alert(hidprno)
            $.ajax({

                type: "POST",
                url: "/PaymentRequest/ValidatePayment",
                processData: false,
                contentType: false,

                data: fileData, // Send FormData directly
                success: function (result) {
                    //alert(result.success+ result.errormsg);
                    //JSalert(result.success, result.errormsg);

                    Swal.fire({
                        title: result.success,
                        text: result.errormsg,
                        icon: 'success',
                    }).then((response) => {
                        if (response.value) {
                            location.reload(true);
                        }
                    })

                    
                },
                error: function (xhr, status, error) {
                    //alert(status);
                    JSalert(result.SUCCESS, result.errormsg);
                }
            });

        });

        //$(document).ajaxStart(function () {
        //    $("#loadingImg").show();
        //    $("#fileButton").prop('disabled', true);
        //});

        //$(document).ajaxStop(function () {
        //    $("#loadingImg").hide();
        //    $("#fileButton").prop('disabled', false);
        //    $("#fileInput").val("");
        //});

    });

    function JSalert(msgType, msg) {
        if (msgType == "SUCCESS") {
            Swal.fire(msg, "Payment Request", "success", 2000, true).then(okay => {
                if (okay) {
                    location.reload(true);
                }
            });
        } else {
            Swal.fire(msg, "Payment Request", "error", 2000, true);
        }
    }

</script>

