        function disapproveswal() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: true
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure you want to disapprove this request.',
                text: "Please type reason :",
                input: 'select',
                inputOptions: getDropdownOptions(),
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Confirm Disapprove',
                cancelButtonText: 'No, cancel!',
                reverseButtons: false
            }).then((result) => {
                if (result.isConfirmed) {
                    var selectedReason = result.value;
                    var values = $('input[type="checkbox"].myCheckbox:checked').map(function () {
                        return $(this).val();

                    }).toArray();

                    var url2 = '@Url.Action("DisapprovePRAuthorizationALL", "Authorization")';

                    $.ajax(
                        {
                            url: url2,
                            data: {
                                prno: JSON.stringify(values),
                                reason: selectedReason // Include the selected reason in the data sent to the server
                            },
                            dataType: "JSON",
                            type: "GET",
                            success: function (response) {
                                JSalert(response.success, response.errormsg);
                            }
                        });

                    return false;

                    swalWithBootstrapButtons.fire(
                        'Disapprove!',
                        'Payment Request has been Disapprove.',
                        'success'
                    )
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel

                ) {
                    swalWithBootstrapButtons.fire(
                        'Cancelled',
                        'This payment is not yet confirm to disapprove',
                        'cancel'
                    )
                }
            })
        }

