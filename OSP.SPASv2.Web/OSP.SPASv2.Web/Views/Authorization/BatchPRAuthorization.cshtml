    <script>

        function ShowDenyReason() {

            $("#modalDenyRequest").modal("show");
        }

        function ConfirmDenialRequest() {

            var values = $('input[type="checkbox"].myCheckbox:checked').map(function () {
                return $(this).val();}).toArray();

            var rescode = $('#cboDenialReason').val();
            var remarks = $('#txtDenialRemarksId').val();


            if (ValidateReason(rescode, remarks, "deny") == false) { return; }

            $("#modalDenyRequest").modal("hide");

            $.ajax({
                type: "POST",
                url: "/Authorization/DisapprovePRAuthorizationALL",
                    data: { prno: JSON.stringify(values), reason: rescode, Remarks: remarks },
                dataType: 'json',
                beforeSend: function () {
                    ShowLoader();
                },
                success: function (result) {
                    if (result.success) {
                        ShowAlert({
                            title: 'Requisition',
                            text: "Requisitions successfully tagged as denied!",
                            icon: 'success',
                            successmethod: "ReloadPage()",
                        });
                    }
                    else {
                        ShowAlert({
                            title: 'Requisition',
                            text: result.errormsg,
                            icon: 'error',
                        });
                    }
                },
                error: function (xhr, status, error) {

                },
                complete: function (data) {
                    $("#loader").modal("hide");
                }
            });
        }

        function ReloadPage() {
            location.reload(true);
        }


        function getCount() {
            var comboBoxes = document.querySelectorAll("select");
            var selected = [];
            for (var i = 1, len = comboBoxes.length; i < len; i++) {
                var combo = comboBoxes[i];
                var options = combo.children;
                for (var j = 0, length = options.length; j < length; j++) {
                    var option = options[j];
                    if (option.selected) {
                        selected.push(option.text);
                    }
                }
            }
          
           
        }



