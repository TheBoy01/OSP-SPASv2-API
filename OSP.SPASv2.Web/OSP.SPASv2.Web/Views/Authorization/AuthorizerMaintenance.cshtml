<main id="main" class="main">

    @* <h1>Endorsement</h1>*@
    <h1>Authorizer Maintenance</h1>
    @*<h1>Verification</h1>*@
    <div class="col-12">
        <div class="card recent-sales overflow-auto">

            <div class="form-group col-md-6">
                <div>
                    <label asp-for="PaymentClass" class="form-label required"></label>
                    @*@Html.DropDownListFor(model => model.PaymentClass, new SelectList(Model.Paymenttypelist, "PayClassCode", "PayDesc"), "-- SELECT PAYMENT --", htmlAttributes: new { @class = "form-select" })*@
                    @Html.DropDownListFor(model => model.PaymentClass, new SelectList(Model.Paymenttypelist, "PayClassCode", "PayDesc"), "-- SELECT PAYMENT CLASS--", htmlAttributes: new { @class = "form-select" , @id = "cmbPayClasss" })
                </div>
                <p><strong></strong></p>
                <div> 
                    <input type="submit" value="Add Authorizer" id="btnSun" class="btn btn-success" />
                    <input type="submit" value="Delete Authorizer" id="btnApprove" class="btn btn-danger" />
                </div>


                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body">
                            <h2 class="card-title center">List of Assigned Payclass</h2>

                            <table class="table table-bordered">
                                <thead>

                                    <tr>
                                        <th scope="col">Person ID</th>
                                        <th scope="col">Payment Class</th>
                                        <th scope="col">Authorize Level</th>
                                        <th scope="col">Authorize Class</th>

                                    </tr>
                                </thead>

                                <tbody id="tbodyauthpayclass">
                                </tbody>

                            </table>


                        </div>
                    </div>
                </div>



                <span asp-validation-for="PaymentClass" class="text-danger"></span>
            </div>
        </div>
    </div>


    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#cmbPayClasss").on('change', function () {

                var selValue = $('#cmbPayClasss').val();

                //var url2 = '@Url.Action("AuthorizerPayclassListsByPayclass", "Authorization")';

                $.ajax({
                    url: "/Authorization/AuthorizerPayclassListsByPayclass",
                    type: "GET",
                    data: { payclass: selValue },
                    //beforeSend: function () {
                    //    $("#loader").show();
                    //},
                    success: function (data) {

                        //$("#tbodyauthpayclass").append(data);
                        //alert(data);
                        $("#tbodyauthpayclass").html(data);
                        //$("#Generic_Modal").modal('show');
                    },
                    error: function (xhr, status, error) {
                        alert(xhr.responseText);
                    },
                    complete: function (data) {
                        //$("#loader").hide();
                    }
                })

                //$.ajax({
                //    url: "/Authorization/AuthorizerPayclassListsByPayclass",
                //    type: "GET",
                //    //dataType: "json",
                //    data: { payclass: selValue },
                //    success: function (data) {
                //        {
                //            alert(data);
                //            //$("#tbodyauthpayclass").append(data);

                //        },
                //        failure: function (data) {
                //            alert('oops something went wrong');
                //        }
                //    })
            });
        });

    </script>


</main>
