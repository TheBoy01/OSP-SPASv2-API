        function disapproveswal() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure you want to disapprove this payment request.',
                text: "Please type reason :",
                input: 'text',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Confirm Disapprove',
                cancelButtonText: 'No, cancel!',
                reverseButtons: false
            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire(
                        'Disapprove!',
                        'Payment Request has been Disapprove.',
                        'success'
                    )
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire(
                        'Cancelled',
                        'This payment is not yet confirm to approve',
                        'cancel'
                    )
                }
            })
        }
        function titleCase(str) {
            str = str.toLowerCase().split(' ');
            for (var i = 0; i < str.length; i++) {
                str[i] = str[i].charAt(0).toUpperCase() + str[i].slice(1);
            }
            return str.join(' ');
        }

        function approveswal() {
            var stringAuthirizeClass = $('#approved').val();
            var stringAuthirizeClass2;

            stringAuthirizeClass = stringAuthirizeClass.toString().toLowerCase();
            var checkboxes = $('input:checkbox:checked').length;
            if (checkboxes > 0) {

                const swalWithBootstrapButtons = Swal.mixin({
                    customClass: {
                        confirmButton: 'btn btn-success',
                        cancelButton: 'btn btn-danger'
                    },
                    buttonsStyling: true
                })
                swalWithBootstrapButtons.fire({
                    title: 'Are you sure you want to ' + stringAuthirizeClass + ' all selected request?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: titleCase(stringAuthirizeClass),
                    cancelButtonText: 'Cancel',
                    reverseButtons: false

                    //Swal.fire({
                    //title: 'Are you sure you want to ' + stringAuthirizeClass + ' all selected  request?',
                    //icon: 'question',
                    //showCancelButton: true,
                    //confirmButtonColor: titleCase(stringAuthirizeClass),
                    // cancelButtonColor: 'Cancel',
                    //reverseButtons: false






                }).then((result) => {
                    if (result.isConfirmed) {

                        var values = $('input[type="checkbox"].myCheckbox:checked').map(function () {
                            return $(this).val();

                        }).toArray();

                        var url2 = '@Url.Action("ApprovePRAuthorizationALL", "Authorization")';

                        $.ajax(
                            {
                                url: url2,
                                data: 'prno=' + JSON.stringify(values),
                                dataType: "JSON",
                                type: "GET",
                                beforeSend: function () {
                                    ShowLoader();
                                },
                                success: function (response) {
                                    JSalert(response.success, response.errormsg);

                                },
                                error: function (xhr, status) {
                                    JSalert(status, xhr.statusText);
                                    alert(xhr.statusText);
                                }

                                        complete: function (data) {
                                    $("#loader").modal("hide");
                                }
                            }
                        );

                        return false;

                        swalWithBootstrapButtons.fire(
                            stringAuthirizeClass,
                            'Payment Request has been ' + stringAuthirizeClass,
                            'success'
                        )



                    } else if (
                        /* Read more about handling dismissals below */
                        result.dismiss === Swal.DismissReason.cancel

                    ) {
                        //swalWithBootstrapButtons.fire(
                        //    'Cancelled',
                        //    'This payment request is not yet confirm to ' + stringAuthirizeClass,
                        //    'cancel'
                        //)
                    }
                })


            }

            if (checkboxes == 0) {


                myFunction();
                return;
            }







        }

        function disapproveswal2() {

