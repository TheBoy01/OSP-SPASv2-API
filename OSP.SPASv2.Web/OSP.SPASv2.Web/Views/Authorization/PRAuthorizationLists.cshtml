        function JSalert(msgType, msg) {
            if (msgType == "SUCCESS") {
                Swal.fire(msg, "Authorization", "success", 2000, true).then(okay => {
                    if (okay) {
                        location.reload(true);
                    }
                });
            } else {
                Swal.fire(msg, "Authorization", "error", 2000, true);
