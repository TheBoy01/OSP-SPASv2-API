                margin: 0 10px 0 0;
            }

        .site-navigation {
            float: right;
        }

            .site-navigation ul, li {
                margin: 0;
                padding: 0;
            }

            .site-navigation li {
                display: inline-block;
                margin: 1.4em 1em 1em 1em;
            }

